# Example environment variables (DO NOT commit real keys)
# Copy this file to `.env` for local development and fill in real values.

# Public (client-side) env variables used at build time:
VITE_SUPABASE_URL=https://<your-supabase>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=pk.<your-publishable-key>
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=AIzaSy<your-browser-key>

# Server-only secrets (do NOT expose to client; set these as masked provider secrets)
# SUPABASE_SERVICE_ROLE_KEY=sr.<your-service-role-key>
# STRIPE_SECRET_KEY=sk_live_...

# Notes:
# - Rotate any keys that were previously committed to the repository.
# - Do not commit .env files. .gitignore already contains ".env*" to prevent accidental commits.
